# Catppuccin Mocha with high-contrast urgency colors.
font=IosevkaTerm Nerd Font SemiBold 11
background-color=#89b4fa
text-color=#11111b
border-color=#cdd6f4
progress-color=over #b4befe

anchor=top-right
layer=overlay
width=420
height=180
margin=12
padding=12
border-size=2
border-radius=6
text-alignment=left

icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1

default-timeout=7000
ignore-timeout=0
max-visible=5
max-history=50
history=1
group-by=app-name
format=<b>%s</b>\n%b

on-button-left=invoke-default-action
on-button-middle=dismiss-group
on-button-right=dismiss

[urgency=low]
background-color=#45475a
text-color=#cdd6f4
border-color=#7f849c
default-timeout=4000

[urgency=critical]
background-color=#f38ba8
border-color=#f5c2e7
text-color=#11111b
default-timeout=0

[grouped]
format=(%g) <b>%s</b>\n%b
invisible=1

[group-index=0]
invisible=0

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb urgency=critical]
invisible=0
